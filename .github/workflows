name: Deploy wedding invitation

on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Check out the invitation
        uses: actions/checkout@v4
      - name: Read the public Pages URL
        id: pages
        uses: actions/configure-pages@v5
      - name: Prepare static files and sharing metadata
        env:
          SITE_URL: ${{ steps.pages.outputs.base_url }}
        run: python3 scripts/prepare_pages.py --site-url "$SITE_URL" --output "_site"
      - name: Upload the finished site
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site
      - name: Publish the invitation
        id: deployment
        uses: actions/deploy-pages@v5
